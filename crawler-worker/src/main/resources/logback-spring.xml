<?xml version="1.0" encoding="UTF-8"?>
<!--
    crawler-worker 日志配置：
    - 控制台：INFO 以上
    - logs/info.log：INFO 以上（全部日志）
    - logs/error.log：ERROR 以上（只看异常）

    跑完批后：
      cat logs/error.log              → 只看异常
      grep "关键词" logs/info.log      → 查请求/解析/写入细节
-->
<configuration>

    <property name="LOG_DIR" value="./logs"/>
    <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%thread] %logger{50} : %msg%n"/>

    <!-- 控制台 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- info.log：INFO 以上（全部，按大小+时间滚动） -->
    <appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/info.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- error.log：ERROR 以上（只看异常，带完整堆栈 %ex） -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}%ex</pattern>
        </encoder>
    </appender>

    <!-- 请求链路（排查时改 DEBUG） -->
    <logger name="com.dunwugudao.crawler.strategy.eastmoney" level="INFO"/>
    <logger name="com.dunwugudao.crawler.persistence.service.DedupWriter" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_INFO"/>
        <appender-ref ref="FILE_ERROR"/>
    </root>

</configuration>
