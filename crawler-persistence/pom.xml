<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dunwugudao</groupId>
        <artifactId>crawler-backend</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>crawler-persistence</artifactId>
    <name>crawler-persistence</name>
    <description>持久层：MyBatis 原生 XML + 双数据源（openGauss 操作型 + ClickHouse 分析型）</description>

    <dependencies>
        <dependency>
            <groupId>com.dunwugudao</groupId>
            <artifactId>crawler-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 原生 MyBatis（CK 无 MP 方言，退回到 mybatis-spring-boot-starter 3.0.3） -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <!-- openGauss / PostgreSQL 驱动（操作型数据源，支持 SKIP LOCKED / 事务） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- ClickHouse JDBC（分析型数据源，批量追加 + ReplacingMergeTree） -->
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
        </dependency>
        <!-- Apache HTTP 客户端 5.x（clickhouse-jdbc 默认 transport） -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>5.3.1</version>
        </dependency>
        <!-- LZ4 压缩 -->
        <dependency>
            <groupId>org.lz4</groupId>
            <artifactId>lz4-java</artifactId>
            <version>1.8.0</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
