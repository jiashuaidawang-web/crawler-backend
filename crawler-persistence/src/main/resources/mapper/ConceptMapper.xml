<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dunwugudao.crawler.persistence.mapper.ConceptMapper">

    <!-- ClickHouse MergeTree 批量追加（对齐 DDL：补 theme_code 主键、source→data_source、补 src_detail） -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO concept
        (
        theme_code,
        theme_name,
        theme_type,
        scarcity,
        imagination,
        data_source,
        src_detail,
        create_date,
        update_date
        )
        VALUES
        <foreach collection="list" item="r" separator=",">
            (
             #{r.themeCode},
             #{r.themeName},
             #{r.themeType},
             #{r.scarcity},
             #{r.imagination},
             #{r.dataSource},
             #{r.srcDetail},
             #{r.createDate},
             #{r.updateDate}
            )
        </foreach>
    </insert>

</mapper>
