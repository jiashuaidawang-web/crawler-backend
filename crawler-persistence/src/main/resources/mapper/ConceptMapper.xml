<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dunwugudao.crawler.persistence.mapper.ConceptMapper">

    <!-- ClickHouse MergeTree 批量追加 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO concept
        (
        theme_name,
        theme_type,
        scarcity,
        imagination,
        source,
        create_date,
        update_date
        )
        VALUES
        <foreach collection="list" item="r" separator=",">
            (
             #{r.themeName},
             #{r.themeType},
             #{r.scarcity},
             #{r.imagination},
             #{r.source},
             #{r.createDate},
             #{r.updateDate}
            )
        </foreach>
    </insert>

</mapper>
