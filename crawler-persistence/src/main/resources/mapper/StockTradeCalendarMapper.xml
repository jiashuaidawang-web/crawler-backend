<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dunwugudao.crawler.persistence.mapper.StockTradeCalendarMapper">

    <!--
        ClickHouse ReplacingMergeTree 批量追加：同 trade_date 重复 seed 由 update_date 保留最新版，幂等。
        注意：ClickHouse 不支持 MyBatis 的 <foreach> 批量 VALUES 写法（只认单条 INSERT ... VALUES (...)），
        这里用 UNION ALL SELECT 兼容 ClickHouse。
    -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO stock_trade_calendar
        (
        trade_date,
        is_trading,
        data_source,
        src_detail,
        create_date,
        update_date
        )
        VALUES
        <foreach collection="list" item="r" separator=",">
            (
             #{r.tradeDate},
             #{r.isTrading},
             #{r.dataSource},
             #{r.srcDetail},
             #{r.createDate},
             #{r.updateDate}
            )
        </foreach>
    </insert>

</mapper>
